System cargoservice
// Modello dei requisiti

// Customer requests (from requirements: request to load, reserved slot, retrylater, reject)
Request load : load(CLIENT_ID)
Reply reserved : reserved(SLOT) for load
Reply retrylater : retrylater(REASON) for load
Reply reject : reject(REASON) for load

// Sonar measurements (from requirements: measures a distance D)
Dispatch distance : distance(D)

// Robot commands (from requirements: uses cargorobot to move the container)
Request move_robot : move_robot(DEST)
Reply move_done : move_done(RESULT) for move_robot

// Marker commands (from requirements: marker device labels and signals when completed)
Dispatch start_marking : start_marking(SLOT)
Dispatch marking_done : marking_done(SLOT)

// Led commands (from requirements: blink a Led while engaged, off otherwise)
Dispatch led_state : led_state(STATE) // STATE: "blink" or "off"

// Display updates (from requirements: show current state of the hold, 'Service working', 'Out of service')
Dispatch display_msg : display_msg(MSG)

Context ctx_cargoservice ip [ host="localhost" port=8082 ]

/*
 * cargoservice: orchestrator actor implementing the business requirements
 */
QActor cargoservice context ctx_cargoservice {
    [#
        var Slot1Occupied = false
        var Slot2Occupied = false
        var Slot3Occupied = false
        var Slot4Occupied = false
        var SystemOutOfService = false
        var IOPortOccupied = false
        var ReservedSlot = ""
    #]

    State s0 initial {
        println("cargoservice | starting...") color blue
        [# SystemOutOfService = false #]
        forward ioport -m display_msg : display_msg(service_working)
    }
    Goto working

    State working {
        println("cargoservice | waiting for load requests...") color blue
    }
    Transition t0
        whenRequest load -> handleLoadRequest
        whenMsg distance -> handleDistanceLimit

    State handleLoadRequest {
        onMsg(load : load(CLIENT_ID)) {
            [#
                if (SystemOutOfService || IOPortOccupied) {
            #]
                    replyTo load with retrylater : retrylater(busy_or_out_of_service)
            [#
                } else if (Slot1Occupied && Slot2Occupied && Slot3Occupied && Slot4Occupied) {
            #]
                    replyTo load with reject : reject(hold_full)
            [#
                } else {
                    if (!Slot1Occupied) ReservedSlot = "slot1"
                    else if (!Slot2Occupied) ReservedSlot = "slot2"
                    else if (!Slot3Occupied) ReservedSlot = "slot3"
                    else if (!Slot4Occupied) ReservedSlot = "slot4"
            #]
                    println("cargoservice | request accepted, reserved $ReservedSlot") color blue
                    replyTo load with reserved : reserved($ReservedSlot)
                    forward led -m led_state : led_state(blink)
            [#
                }
            #]
        }
    }
    Goto waitingForContainer if [# ReservedSlot != "" #] else working

    State waitingForContainer {
        println("cargoservice | waiting for container at IOPort sensor area...") color blue
    }
    Transition t0
        whenTime 30000 -> handleTimeout
        whenMsg distance -> checkContainerArrival

    State checkContainerArrival {
        onMsg(distance : distance(D)) {
            [#
                val DVal = payloadArg(0).toDouble()
                // D < DFREE/2 to detect presence
                if (DVal < 10.0) {
                    IOPortOccupied = true
                }
            #]
        }
    }
    Goto robotExecution if [# IOPortOccupied #] else waitingForContainer

    State robotExecution {
        println("cargoservice | using cargorobot to load container...") color blue
        request cargorobot -m move_robot : move_robot(ioport)
    }
    Transition t0
        whenReply move_done -> robotAtIOPort

    State robotAtIOPort {
        request cargorobot -m move_robot : move_robot(slot5)
    }
    Transition t0
        whenReply move_done -> robotAtSlot5

    State robotAtSlot5 {
        forward marker -m start_marking : start_marking($ReservedSlot)
    }
    Transition t0
        whenMsg marking_done -> markingCompleted

    State markingCompleted {
        request cargorobot -m move_robot : move_robot($ReservedSlot)
    }
    Transition t0
        whenReply move_done -> robotAtReservedSlot

    State robotAtReservedSlot {
        [#
            if (ReservedSlot == "slot1") Slot1Occupied = true
            else if (ReservedSlot == "slot2") Slot2Occupied = true
            else if (ReservedSlot == "slot3") Slot3Occupied = true
            else if (ReservedSlot == "slot4") Slot4Occupied = true
            
            IOPortOccupied = false
            ReservedSlot = ""
        #]
        forward led -m led_state : led_state(off)
        request cargorobot -m move_robot : move_robot(home)
    }
    Transition t0
        whenReply move_done -> robotExecutionCompleted

    State robotExecutionCompleted {
        println("cargoservice | container loaded successfully") color blue
        forward ioport -m display_msg : display_msg(service_working)
    }
    Goto working

    State handleTimeout {
        println("cargoservice | client timeout, disengaging...") color blue
        forward led -m led_state : led_state(off)
        [# ReservedSlot = "" #]
    }
    Goto working

    State handleDistanceLimit {
        onMsg(distance : distance(D)) {
            [#
                val DVal = payloadArg(0).toDouble()
                // D > DFREE for at least 3 secs simulates Out of Service
                if (DVal > 20.0) {
                    SystemOutOfService = true
                }
            #]
        }
    }
    Goto handleOutOfService if [# SystemOutOfService #] else working

    State handleOutOfService {
        println("cargoservice | system out of service!") color red
        forward led -m led_state : led_state(off)
        forward ioport -m display_msg : display_msg(out_of_service)
    }
    Transition t0
        whenMsg distance -> checkRecovery
        whenRequest load -> handleLoadRequest // will reply busy/out of service

    State checkRecovery {
        onMsg(distance : distance(D)) {
            [#
                val DVal = payloadArg(0).toDouble()
                if (DVal <= 20.0) {
                    SystemOutOfService = false
                }
            #]
        }
    }
    Goto working if [# !SystemOutOfService #] else handleOutOfService
}

/*
 * Mock of cargorobot for Sprint 0 simulation
 */
QActor cargorobot context ctx_cargoservice {
    State s0 initial {
        println("cargorobot | ready") color green
    }
    Transition t0
        whenRequest move_robot -> doMove

    State doMove {
        onMsg(move_robot : move_robot(DEST)) {
            [# val Dest = payloadArg(0) #]
            println("cargorobot | moving to $Dest...") color green
            delay 1000 // simulate movement time
            println("cargorobot | reached $Dest") color green
            replyTo move_robot with move_done : move_done(success)
        }
    }
    Transition t0
        whenRequest move_robot -> doMove
}

/*
 * QActor customer: Simulates customer interaction via pushbutton request
 */
QActor customer context ctx_cargoservice {
    State s0 initial {
        println("customer | pressing pushbutton to request load...") color magenta
        request cargoservice -m load : load(client1)
    }
    Transition t0
        whenReply reserved -> handleReserved
        whenReply retrylater -> handleRetry
        whenReply reject -> handleReject

    State handleReserved {
        onMsg(reserved : reserved(SLOT)) {
            [# val Slot = payloadArg(0) #]
            println("customer | request accepted, reserved slot: $Slot. Placing container...") color magenta
        }
    }
    
    State handleRetry {
        println("customer | load request busy/retry later") color magenta
    }
    
    State handleReject {
        println("customer | load request rejected") color magenta
    }
}

/*
 * QActor sonar: Simulates distance measurements
 */
QActor sonar context ctx_cargoservice {
    State s0 initial {
        // Wait 2.5 seconds, then simulate container arrival at IOPort
        delay 2500
        println("sonar | container presence detected (distance = 5)") color yellow
        forward cargoservice -m distance : distance(5)
    }
}

QActor led context ctx_cargoservice {
    State s0 initial {
        println("led | started") color cyan
    }
    Transition t0
        whenMsg led_state -> handleState

    State handleState {
        onMsg(led_state : led_state(STATE)) {
            [# val State = payloadArg(0) #]
            println("led | state changed: $State") color cyan
        }
    }
    Transition t0
        whenMsg led_state -> handleState
}

QActor marker context ctx_cargoservice {
    State s0 initial {
        println("marker | ready") color yellow
    }
    Transition t0
        whenMsg start_marking -> doMarking

    State doMarking {
        onMsg(start_marking : start_marking(SLOT)) {
            [# val Slot = payloadArg(0) #]
            println("marker | marking container for $Slot...") color yellow
            delay 1500 // simulate marking duration
            println("marker | marking completed for $Slot") color yellow
            forward cargoservice -m marking_done : marking_done($Slot)
        }
    }
    Transition t0
        whenMsg start_marking -> doMarking
}

QActor ioport context ctx_cargoservice {
    State s0 initial {
        println("ioport | display init: service_working") color yellow
    }
    Transition t0
        whenMsg display_msg -> handleDisplay

    State handleDisplay {
        onMsg(display_msg : display_msg(MSG)) {
            [# val Msg = payloadArg(0) #]
            println("ioport | display message: $Msg") color yellow
        }
    }
    Transition t0
        whenMsg display_msg -> handleDisplay
}
